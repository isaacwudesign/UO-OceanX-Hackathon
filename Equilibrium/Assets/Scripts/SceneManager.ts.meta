  InputLines:
    - '// @ui {"widget":"group_start", "label":"Scene Flow"}'
    - '// @input SceneObject introFrame {"hint":"Intro UI frame shown at lens start"}'
    - '// @input SceneObject enterButton {"hint":"ENTER CapsuleButton on the intro (EnterButton)"}'
    - '// @input AssignableType surfacePlacement {"hint":"SurfacePlacement Example component (autoStart should be off)"}'
    - '// @input SceneObject placedVisuals {"hint":"Content root enabled after successful placement (VisualParent)"}'
    - '// @input SceneObject clownfishCircling {"hint":"Clownfish orbit group, hidden until all corals are placed"}'
    - '// @input SceneObject platform {"hint":"Placement surface hidden after After Placing VO finishes"}'
    - '// @input SceneObject temperatureScenarios {"hint":"Tempature Scenarios group. Keep this OFF in the editor; children stay ON."}'
    - '// @input SceneObject temperatureSlider {"hint":"Temperature UI shown after After Placing VO finishes"}'
    - '// @input SceneObject temperatureFactsFrame {"hint":"Facts panel shown with the temperature slider"}'
    - '// @input SceneObject temperatureKnowledgeFrame {"hint":"Knowledge panel shown with the temperature slider"}'
    - '// @input AssignableType_1 temperatureWater {"hint":"Temperature challenge (water tint / VO). Mesh tint is optional."}'
    - '// @input SceneObject trashScenarios {"hint":"Trash Scenarios group. Disabled until temperature Solve VO finishes."}'
    - '// @input AssignableType_2 trashPickup {"hint":"TrashPickupManager on Trash Scenarios"}'
    - '// @input SceneObject overfishingScenarios {"hint":"Overfishing Scenarios group. Keep OFF in the editor; children stay ON."}'
    - '// @input AssignableType_3 overfishingPush {"hint":"OverfishingBoatPushManager on Overfishing Scenarios"}'
    - '// @input SceneObject billboardPinchCoral {"hint":"Billboard copy group Pinch_Coral. Keep OFF in the editor; children stay ON."}'
    - '// @input SceneObject billboardTemperature {"hint":"Billboard copy group Temperature. Keep OFF in the editor; children stay ON."}'
    - '// @input SceneObject billboardTrash {"hint":"Billboard copy group Trash. Keep OFF in the editor; children stay ON."}'
    - '// @input SceneObject billboardOverfishing {"hint":"Billboard copy group Overfishing. Keep OFF in the editor; children stay ON."}'
    - '// @input SceneObject billboardThankYou {"hint":"Billboard copy group Thank you. Keep OFF in the editor; children stay ON. Shown with EndingVO."}'
    - '// @input vec4 introFrameColor = {0.05,0.32,0.36,1} {"hint":"Intro Frame plate color. Default is deep ocean teal.", "widget":"color"}'
    - '// @input vec4 surfacePlacementColor = {0.05,0.32,0.36,1} {"hint":"Surface placement ring, dashed line, and glow. Default matches intro teal.", "widget":"color"}'
    - '// @input vec4 enterButtonColor = {0,0.706,0.894,1} {"hint":"ENTER button fill. Hover/press auto-lighten and darken. Default is OceanX cyan.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Audio"}'
    - '// @input Component.AudioComponent welcomeAudio {"hint":"Welcome voice-over played during intro"}'
    - '// @input Component.AudioComponent placingAudio {"hint":"Instruction VO played after the user places the surface"}'
    - '// @input Component.AudioComponent afterPlacingAudio {"hint":"VO played once the required number of corals are placed"}'
    - '// @input Component.AudioComponent temperatureExplainAudio {"hint":"VO played when the temperature slider appears"}'
    - '// @input Component.AudioComponent endingAudio {"hint":"Ending VO after OverfishingIssueSolveVO finishes. Do not stop()/pause()."}'
    - '// @input bool muteHeadsetOnDevice = true {"hint":"On Specs, mute glasses speakers so mics do not echo Mix-to-Snap. Lens Studio preview still plays. Uncheck to hear VO live on device."}'
    - '// @ui {"widget":"group_end"}'
