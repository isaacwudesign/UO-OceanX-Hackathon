  InputLines:
    - '// @ui {"widget":"group_start", "label":"Audio"}'
    - '// @input Component.AudioComponent explainAudio {"hint":"OverfishingIssueExplain. Do not stop()/pause()."}'
    - '// @input Component.AudioComponent solveAudio {"hint":"OverfishingIssueSolveVO. Plays after all boats leave the tank."}'
    - '// @input Component.AudioComponent shoveSfx {"hint":"Fishboats_shovingSFX. Plays on each new palm contact. Do not stop()/pause()."}'
    - '// @input Asset.AudioTrackAsset shoveSfxTrack {"hint":"Fishboats_shovingSFX.mp3 — assigned onto shove voices."}'
    - '// @input Component.AudioComponent doneSfx {"hint":"Fishboats_Shoving_Done_SFX. Plays when a boat leaves the tank. Do not stop()/pause()."}'
    - '// @input Asset.AudioTrackAsset doneSfxTrack {"hint":"Fishboats_Shoving_Done_SFX.mp3 — assigned onto done voices."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Tank"}'
    - '// @input SceneObject tankRoot {"hint":"TouchTank — boats stay on this water plane and leave in tank-local XZ."}'
    - '// @input float tankHalfExtentX = 160 {"hint":"Tank-local half-width. Match CoralSnapManager (TouchTank is scaled 0.2)."}'
    - '// @input float tankHalfExtentZ = 160 {"hint":"Tank-local half-depth. Match CoralSnapManager (TouchTank is scaled 0.2)."}'
    - '// @input float exitMargin = 25 {"hint":"Extra tank-local distance past the rectangle that counts as off the water."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Palm shove (heavy water)"}'
    - '// @input float pushRadius = 22 {"hint":"cm. Palm must be this close to the hull — not a wide magnet bubble."}'
    - '// @input float palmFollow = 0.32 {"hint":"While touching, boat matches this fraction of palm speed (lower = heavier)."}'
    - '// @input float maxSpeed = 36 {"hint":"Max slide speed in cm/s. Stops teleport flicks."}'
    - '// @input float waterDrag = 2.4 {"hint":"Water drag (1/s). Higher = boats die sooner after a sweep."}'
    - '// @input float inwardAccel = 16 {"hint":"Pull toward tank center / reef (cm/s²). They creep in unless you sweep them out."}'
    - '// @input float hullSeparation = 22 {"hint":"World-cm hull radius. Not multiplied by boat scale (scale 2.3 would yeet them off the tank)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Frames"}'
    - '// @input SceneObject factsFrame {"hint":"Overfishing facts frame, hidden after Solve VO finishes"}'
    - '// @input SceneObject knowledgeFrame {"hint":"Overfishing knowledge frame, hidden after Solve VO finishes"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Surface Float"}'
    - '// @input bool floatOnSurface = true {"hint":"Gentle bob and rock so boats read as sitting on the water."}'
    - '// @input float bobHeight = 2 {"hint":"World-Y bob height in cm. 1.5–3 is a small swell on this tank.", "widget":"slider", "min":0, "max":10, "step":0.25}'
    - '// @input float rockAngle = 6 {"hint":"Pitch/roll in degrees. Keep under ~10 so shove still feels solid.", "widget":"slider", "min":0, "max":20, "step":0.5}'
    - '// @input float floatSpeed = 0.4 {"hint":"How fast the surface motion cycles, in waves per second.", "widget":"slider", "min":0.1, "max":1.5, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
